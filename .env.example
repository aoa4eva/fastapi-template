# Application Settings
APP_NAME=generaltemplate
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# API Settings
API_PREFIX=/api
API_VERSION=v1

# Security Settings
# IMPORTANT: Generate a secure secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# CORS Settings
# Comma-separated list of allowed origins
# For development: http://localhost:3000,http://localhost:8000
# For production: https://yourdomain.com
ALLOWED_HOSTS=*

# Database Settings (uncomment when using database)
# For PostgreSQL: postgresql://user:password@localhost:5432/dbname
# For SQLite: sqlite:///./generaltemplate.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/generaltemplate
# DATABASE_ECHO=false

# Redis Settings (uncomment when using Redis)
# REDIS_URL=redis://localhost:6379/0

# External API Settings (example - customize as needed)
# EXTERNAL_API_KEY=your-api-key-here
# EXTERNAL_API_URL=https://api.example.com

# Logging Settings (optional)
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Email Settings (example - customize as needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# AWS Settings (example - customize as needed)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=your-bucket-name

# OAuth Settings (example - customize as needed)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
